---
import Detail from '../../../views/Detail.astro';
import { getProjects, entrySlug } from '../../../lib/content';

export async function getStaticPaths() {
  const items = await getProjects('en');
  return items.map((entry) => ({ params: { slug: entrySlug(entry.id) }, props: { entry } }));
}
---

<Detail lang="en" entry={Astro.props.entry} />
