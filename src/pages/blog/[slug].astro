---
import Detail from '../../views/Detail.astro';
import { getPosts, entrySlug } from '../../lib/content';

export async function getStaticPaths() {
  const posts = await getPosts('tr');
  return posts.map((entry) => ({ params: { slug: entrySlug(entry.id) }, props: { entry } }));
}
---

<Detail lang="tr" entry={Astro.props.entry} />
