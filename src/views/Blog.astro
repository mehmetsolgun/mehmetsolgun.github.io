---
import Base from '../layouts/Base.astro';
import PostItem from '../components/PostItem.astro';
import { useTranslations, type Lang } from '../i18n/ui';
import { getPosts } from '../lib/content';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const posts = await getPosts(lang);
const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))];
---

<Base lang={lang} title={t('blog.title')} chrom="chr5" pageLabel="blog">
  <header class="wrap page-head">
    <h1>{t('blog.title')}</h1>
    <p>{t('blog.lead')}</p>
  </header>
  {posts.length === 0 && <p class="wrap muted">{t('blog.empty')}</p>}
  {
    years.map((y) => (
      <section class="section" data-locus={String(y)}>
        <div class="wrap">
          <h2 class="mono year">{y}</h2>
          <ul>
            {posts
              .filter((p) => p.data.date.getFullYear() === y)
              .map((p) => (
                <PostItem post={p} lang={lang} />
              ))}
          </ul>
        </div>
      </section>
    ))
  }
</Base>

<style>
  .section {
    padding-block: 24px 32px;
  }
  .year {
    margin-bottom: 4px;
    font-size: 0.875rem;
    color: var(--accent);
  }
  ul {
    margin: 0;
    padding: 0;
  }
</style>
