---
// Blog yazısı ve proje detayı için ortak okuma düzeni.
import 'katex/dist/katex.min.css';
import Base from '../layouts/Base.astro';
import { type Lang } from '../i18n/ui';
import type { ChromName } from '../lib/genome';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  chrom: ChromName;
  pageLabel: string;
  altHref: string;
  back: { href: string; label: string };
  jsonLd?: Record<string, unknown>;
  translated?: boolean;
}
const { lang, title, description, chrom, pageLabel, altHref, back, jsonLd, translated } = Astro.props;
---

<Base lang={lang} title={title} description={description} chrom={chrom} pageLabel={pageLabel} altHref={altHref} type="article" jsonLd={jsonLd} translated={translated}>
  <article class="wrap article">
    <header data-locus={title}>
      <a class="back mono" href={back.href}>← {back.label}</a>
      <h1>{title}</h1>
      {description && <p class="lead">{description}</p>}
      <div class="meta mono"><slot name="meta" /></div>
    </header>
    <div class="prose">
      <slot />
    </div>
  </article>
</Base>

<style>
  .article {
    max-width: calc(var(--measure) + 2 * var(--gutter));
    padding-top: clamp(40px, 8vw, 88px);
  }
  .back {
    display: inline-block;
    margin-bottom: 28px;
    font-size: 0.75rem;
    color: var(--muted);
    text-decoration: none;
  }
  h1 {
    font-size: var(--step-3);
    font-weight: 420;
  }
  .lead {
    margin: 16px 0 0;
    font-size: var(--step-1);
    color: var(--fg-soft);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 16px;
    margin: 22px 0 0;
    padding-bottom: 28px;
    border-bottom: 1px solid var(--line);
    font-size: 0.75rem;
    color: var(--muted);
  }
</style>
