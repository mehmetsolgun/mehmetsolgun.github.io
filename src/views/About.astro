---
import Base from '../layouts/Base.astro';
import Locus from '../components/Locus.astro';
import GeneModel from '../components/GeneModel.astro';
import profile from '../data/profile.json';
import { asset, href, pick, useTranslations, type Lang } from '../i18n/ui';
import { profileLinks } from '../lib/links';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const bio = pick(profile, 'bio', lang).split(/\n\s*\n/);
const skills: string[] = (profile as Record<string, any>)[`skills_${lang}`] ?? profile.skills_tr;
const initials = profile.name.split(' ').map((s) => s[0]).join('');
---

<Base lang={lang} title={t('about.title')} chrom="chr2" pageLabel={t('nav.about').toLocaleLowerCase(lang)}>
  <section class="wrap page-head about" data-locus={t('about.title')}>
    <div>
      <p class="mono muted">{pick(profile, 'affiliation', lang)}</p>
      <h1>{t('about.title')}</h1>
      <div class="bio">{bio.map((p) => <p>{p}</p>)}</div>
      <div class="actions">
        {profileLinks.map((l) => <a class="btn" href={l.url} rel="me">{l.label} ↗</a>)}
        <a class="btn primary" href={profile.cv ? asset(profile.cv) : href(lang, 'cv/')}>{profile.cv ? `${t('home.cv')} ↓` : `${t('home.cvWeb')} →`}</a>
      </div>
    </div>
    <figure class="photo">
      {
        profile.photo ? (
          <div class="frame">
            <img src={asset(profile.photo)} alt={profile.name} width="960" height="1200" decoding="async" />
            <span class="scale mono" aria-hidden="true"><i></i>10 µm</span>
          </div>
        ) : (
          <div class="ph mono" aria-hidden="true">{initials}</div>
        )
      }
      <figcaption class="mono muted">Fig. 1 — {profile.name}, {profile.credentials}</figcaption>
    </figure>
  </section>

  <Locus n={1} title={t('about.timeline')}>
    <GeneModel lang={lang} />
  </Locus>

  <Locus n={2} title={t('about.skills')}>
    <ul class="skills">{skills.map((s) => <li class="chip">{s}</li>)}</ul>
  </Locus>
</Base>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: clamp(32px, 6vw, 80px);
    align-items: start;
  }
  .about h1 {
    margin-top: 14px;
  }
  .bio {
    max-width: var(--measure);
    margin: 28px 0;
    font-family: var(--font-serif);
    font-size: var(--step-1);
    line-height: 1.6;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .photo {
    margin: 0;
  }
  .frame {
    position: relative;
  }
  .frame img,
  .ph {
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  .frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.06);
    pointer-events: none;
  }
  /* mikroskop görüntüsü gibi ölçek çubuğu — küçük bir şaka */
  .scale {
    position: absolute;
    right: 12px;
    bottom: 10px;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 3px;
    font-size: 0.625rem;
    color: #fff;
    text-shadow: 0 1px 2px rgba(0, 0, 0, 0.4);
  }
  .scale i {
    display: block;
    width: 44px;
    height: 3px;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.3);
  }
  .ph {
    display: grid;
    place-items: center;
    background: repeating-linear-gradient(0deg, var(--line) 0 1px, transparent 1px 18px), var(--bg-raised);
    border: 1px solid var(--line);
    font-size: 2.5rem;
    color: var(--muted);
  }
  figcaption {
    margin-top: 10px;
    font-size: 0.6875rem;
  }
  .skills {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .skills .chip {
    padding: 6px 12px;
    font-size: 0.8125rem;
    color: var(--fg-soft);
  }
  @media (max-width: 760px) {
    .about {
      grid-template-columns: 1fr;
    }
    .photo {
      max-width: 150px;
      grid-row: 1;
    }
  }
</style>
