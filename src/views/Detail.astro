---
// Blog yazısı ya da proje detay sayfası (her iki dil için).
import { render, type CollectionEntry } from 'astro:content';
import Article from './Article.astro';
import { href, formatDate, useTranslations, type Lang } from '../i18n/ui';
import { entrySlug, hasTranslation, readingMinutes } from '../lib/content';

interface Props {
  lang: Lang;
  entry: CollectionEntry<'blog'> | CollectionEntry<'projects'>;
}
const { lang, entry } = Astro.props;
const t = useTranslations(lang);
const { Content } = await render(entry);
const other: Lang = lang === 'tr' ? 'en' : 'tr';
const post = entry.collection === 'blog' ? entry.data : null;
const project = entry.collection === 'projects' ? entry.data : null;
const section = post ? 'blog' : 'research';
const slug = entrySlug(entry.id);
const altHref = (await hasTranslation(entry.collection, entry.id, other))
  ? href(other, `${section}/${slug}/`)
  : href(other, `${section}/`);
---

<Article
  lang={lang}
  title={entry.data.title}
  description={post?.description ?? project?.summary}
  chrom={post ? 'chr5' : 'chr3'}
  pageLabel={post ? 'blog' : t('nav.research').toLocaleLowerCase(lang)}
  altHref={altHref}
  back={{ href: href(lang, `${section}/`), label: post ? t('blog.back') : t('all.projects') }}
>
  <Fragment slot="meta">
    {post && <time datetime={post.date.toISOString()}>{formatDate(post.date, lang)}</time>}
    {post?.updated && <span>{t('blog.updated')} {formatDate(post.updated, lang)}</span>}
    {post && <span>{readingMinutes(entry.body)} {t('blog.minutes')}</span>}
    {project && <span>{t(`status.${project.status}`)}</span>}
    {project && <span>{project.start}–{project.end ?? ''}</span>}
    {project?.funding && <span>{project.funding}</span>}
    {project?.link && <a href={project.link}>{project.link.replace(/^https?:\/\//, '')} ↗</a>}
    {entry.data.tags.map((tag) => <span class="chip">{tag}</span>)}
  </Fragment>
  <Content />
</Article>
