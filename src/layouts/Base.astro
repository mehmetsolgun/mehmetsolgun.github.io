---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
// Başlık fontu önceden yüklenir; hero başlığı yedek fonttan sıçramaz
import serifLatin from '../../node_modules/@fontsource-variable/source-serif-4/files/source-serif-4-latin-wght-normal.woff2?url';
import serifLatinExt from '../../node_modules/@fontsource-variable/source-serif-4/files/source-serif-4-latin-ext-wght-normal.woff2?url';
import interLatin from '../../node_modules/@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import profile from '../data/profile.json';
import { href, asset, pick, useTranslations, defaultLang, type Lang } from '../i18n/ui';
import { profileLinks } from '../lib/links';
import type { ChromName } from '../lib/genome';

interface Props {
  lang: Lang;
  title?: string;
  description?: string;
  chrom: ChromName;
  pageLabel: string;
  /** Diğer dildeki karşılık; verilmezse aynı yol kullanılır. */
  altHref?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>;
  /** Arama motorlarına kapalı sayfa (404) */
  noindex?: boolean;
  /** Diğer dilde gerçek bir çevirisi var mı? Yoksa hreflang yazılmaz. */
  translated?: boolean;
}

const { lang, title, description, chrom, pageLabel, altHref, type = 'website', jsonLd, noindex = false, translated = true } = Astro.props;
const t = useTranslations(lang);
const other: Lang = lang === 'tr' ? 'en' : 'tr';

// Bu sayfanın dilden bağımsız yolu (ör. "/about/")
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const rest = Astro.url.pathname.slice(base.length).replace(/^\/en(\/|$)/, '/');
const alt = altHref ?? href(other, rest);
const self = href(lang, rest);

const fullTitle = title
  ? `${title} — ${profile.name}`
  : `${profile.name}, ${profile.credentials} — ${t('site.tagline')}`;
const desc = description || pick(profile, 'intro', lang);
const canonical = new URL(self, Astro.site);
// Paylaşım görseli: src/pages/og/[...path].png.ts aynı anahtarla üretir
const ogKey = rest.replace(/\.html$/, '').replace(/^\/|\/$/g, '') || 'index';
const ogImage = new URL(asset(`og/${lang}/${ogKey}.png`), Astro.site);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang={lang} href={canonical} />
          {translated && <link rel="alternate" hreflang={other} href={new URL(alt, Astro.site)} />}
          <link rel="alternate" hreflang="x-default" href={translated ? new URL(href(defaultLang, rest), Astro.site) : canonical} />
        </>
      )
    }
    <link rel="preload" href={serifLatin} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={serifLatinExt} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
    <link rel="icon" type="image/svg+xml" href={asset('favicon.svg')} />
    <link rel="alternate" type="application/rss+xml" title={`${profile.name} — Blog`} href={href(lang, 'rss.xml')} />
    {profileLinks.map((l) => <link rel="me" href={l.url} />)}
    {profile.google_verification && <meta name="google-site-verification" content={profile.google_verification} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_US'} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={fullTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={desc} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#fafaf7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0e12" media="(prefers-color-scheme: dark)" />
    <meta name="generator" content={Astro.generator} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
    <script is:inline>
      try {
        var s = localStorage.getItem('theme');
        document.documentElement.dataset.theme =
          s || (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t('nav.skip')}</a>
    <Header lang={lang} chrom={chrom} pageLabel={pageLabel} altHref={alt} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
