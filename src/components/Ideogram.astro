---
import { chromosomes, bandsFor, type ChromName } from '../lib/genome';

interface Props {
  chrom: ChromName;
  label: string;
}
const { chrom, label } = Astro.props;
const { length, centromere } = chromosomes[chrom];
const pBands = bandsFor(`${chrom}p`, Math.round(centromere * 22) + 3);
const qBands = bandsFor(`${chrom}q`, Math.round((1 - centromere) * 22) + 3);
const pct = (n: number) => `${(n * 100).toFixed(3)}%`;
---

<div class="ideogram" data-ideogram data-chrom={chrom} data-length={length} data-centromere={centromere}>
  <div class="meta mono">
    <span class="name"><b>{chrom}</b> <span class="muted">· {label}</span></span>
    <span class="readout" aria-hidden="true">
      <span data-coord>{chrom}:1–{length.toLocaleString('en-US')}</span>
      <span class="band" data-band></span>
    </span>
  </div>
  <div class="track" data-track aria-hidden="true">
    <div class="arm" style={`width:calc(${pct(centromere)} - 2px)`}>
      {pBands.map((b) => <i class={`s${b.stain}`} style={`left:${pct(b.start)};width:${pct(b.end - b.start)}`} />)}
      <i class="acen" style="right:0;width:10px" />
    </div>
    <div class="arm" style={`width:calc(${pct(1 - centromere)} - 2px)`}>
      {qBands.map((b) => <i class={`s${b.stain}`} style={`left:${pct(b.start)};width:${pct(b.end - b.start)}`} />)}
      <i class="acen" style="left:0;width:10px" />
    </div>
    <div class="window" data-window></div>
  </div>
  <nav class="ticks" data-ticks aria-label={label}></nav>
</div>

<style>
  .ideogram {
    --track-h: 12px;
    user-select: none;
  }
  .meta {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    font-size: 0.6875rem;
    line-height: 1.2;
    margin-bottom: 8px;
    color: var(--fg-soft);
    white-space: nowrap;
    view-transition-name: ideogram-meta;
  }
  .meta b {
    font-weight: 600;
    color: var(--fg);
  }
  .readout {
    display: block;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    font-variant-numeric: tabular-nums;
  }
  .band {
    margin-left: 10px;
    color: var(--accent);
  }
  .track {
    position: relative;
    display: flex;
    gap: 4px;
    height: var(--track-h);
    cursor: crosshair;
    touch-action: none;
    view-transition-name: ideogram-track;
  }
  .arm {
    position: relative;
    height: 100%;
    border-radius: 999px;
    overflow: hidden;
    background: var(--band-0);
  }
  .arm::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 1px var(--line-strong);
    pointer-events: none;
  }
  .arm i {
    position: absolute;
    top: 0;
    bottom: 0;
  }
  .s0 { background: var(--band-0); }
  .s1 { background: var(--band-1); }
  .s2 { background: var(--band-2); }
  .s3 { background: var(--band-3); }
  .s4 { background: var(--band-4); }
  .acen { background: var(--band-acen); opacity: 0.85; }
  .window {
    position: absolute;
    top: -4px;
    bottom: -4px;
    left: 0;
    width: 10%;
    min-width: 6px;
    border: 1.5px solid var(--mark);
    border-radius: 3px;
    background: color-mix(in srgb, var(--mark) 8%, transparent);
    pointer-events: none;
    transition: left 0.08s linear, width 0.2s var(--ease);
  }
  .ticks {
    position: relative;
    height: 18px;
    margin-top: 5px;
  }
  .ticks :global(button) {
    position: absolute;
    top: 0;
    transform: translateX(-50%);
    padding: 4px 2px 0;
    border: 0;
    background: none;
    color: var(--muted);
    font: 500 0.625rem/1 var(--font-mono);
    cursor: pointer;
    white-space: nowrap;
  }
  .ticks :global(button)::before {
    content: '';
    position: absolute;
    left: 50%;
    top: -3px;
    width: 1px;
    height: 5px;
    background: currentColor;
  }
  /* parmakla dokunulabilecek görünmez alan (≥24px) */
  .ticks :global(button)::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 24px;
    height: 24px;
    transform: translate(-50%, -50%);
  }
  .ticks :global(button.h2) {
    color: var(--line-strong);
  }
  .ticks :global(button:hover),
  .ticks :global(button.active) {
    color: var(--accent);
  }
  @media (max-width: 640px) {
    .meta .name .muted,
    .band :global(.label) {
      display: none;
    }
    .ticks :global(button:not(.active)) {
      font-size: 0;
      padding-inline: 4px;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-ideogram]');
  if (root) {
    const chr = root.dataset.chrom!;
    const len = Number(root.dataset.length);
    const cen = Number(root.dataset.centromere);
    const track = root.querySelector<HTMLElement>('[data-track]')!;
    const win = root.querySelector<HTMLElement>('[data-window]')!;
    const coord = root.querySelector<HTMLElement>('[data-coord]')!;
    const bandEl = root.querySelector<HTMLElement>('[data-band]')!;
    const ticks = root.querySelector<HTMLElement>('[data-ticks]')!;
    const fmt = new Intl.NumberFormat('en-US');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let docH = 1;

    // Sayfa içindeki oranı sitogenetik bant adına çevirir (p36.3, q21.1 …)
    const bandCode = (f: number) => {
      const arm = f < cen ? 'p' : 'q';
      const d = arm === 'p' ? (cen - f) / cen : (f - cen) / (1 - cen);
      const span = arm === 'p' ? 25 : 33;
      const x = Math.min(0.9999, d) * span;
      return `${arm}${11 + Math.floor(x)}.${1 + Math.floor((x % 1) * 3)}`;
    };

    // Bölümler: sayfadaki [data-locus] alanları + yazılardaki ara başlıklar (içindekiler)
    const sections = [...document.querySelectorAll<HTMLElement>('[data-locus], .prose h2[id]')].map((el) => {
      const label = el.dataset.locus ?? el.textContent!.replace(/^§\s*/, '').trim();
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.title = label;
      btn.setAttribute('aria-label', label);
      if (!el.dataset.locus) btn.classList.add('h2');
      btn.addEventListener('click', () => el.scrollIntoView({ behavior: reduce ? 'instant' : 'smooth' }));
      ticks.append(btn);
      return { el, label, f: 0, btn };
    });

    const scrollToFraction = (f: number, smooth: boolean) => {
      window.scrollTo({ top: f * docH - innerHeight / 2, behavior: smooth && !reduce ? 'smooth' : 'instant' });
    };

    // Yalnızca konumları günceller; düğmeler yeniden yaratılmaz (odak kaybolmaz)
    const measure = () => {
      docH = Math.max(document.documentElement.scrollHeight, 1);
      for (const s of sections) {
        s.f = (s.el.getBoundingClientRect().top + scrollY) / docH;
        s.btn.textContent = bandCode(s.f);
        s.btn.style.left = `${s.f * 100}%`;
      }
      update();
    };

    const update = () => {
      const f0 = scrollY / docH;
      const f1 = Math.min(1, (scrollY + innerHeight) / docH);
      win.style.left = `${f0 * 100}%`;
      win.style.width = `${(f1 - f0) * 100}%`;
      coord.textContent = `${chr}:${fmt.format(Math.round(f0 * len) + 1)}–${fmt.format(Math.round(f1 * len))}`;
      const probe = (scrollY + innerHeight * 0.35) / docH;
      let active = sections[0];
      for (const s of sections) if (s.f <= probe) active = s;
      if (scrollY + innerHeight >= docH - 2 && sections.length) active = sections[sections.length - 1];
      sections.forEach((s) => s.btn.classList.toggle('active', s === active));
      bandEl.replaceChildren();
      if (active) {
        bandEl.append(active.btn.textContent!);
        const label = document.createElement('span');
        label.className = 'label';
        label.textContent = ` · ${active.label}`;
        bandEl.append(label);
      }
    };

    let ticking = false;
    addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          update();
          ticking = false;
        });
      },
      { passive: true },
    );
    new ResizeObserver(measure).observe(document.body);
    measure();

    // Kromozom üzerinde tıkla ya da sürükle: genom tarayıcısındaki gibi bölgeye git
    let dragging = false;
    const fractionAt = (e: PointerEvent) => {
      const r = track.getBoundingClientRect();
      return Math.min(1, Math.max(0, (e.clientX - r.left) / r.width));
    };
    track.addEventListener('pointerdown', (e) => {
      dragging = true;
      track.setPointerCapture(e.pointerId);
      scrollToFraction(fractionAt(e), true);
    });
    track.addEventListener('pointermove', (e) => dragging && scrollToFraction(fractionAt(e), false));
    const stop = () => (dragging = false);
    track.addEventListener('pointerup', stop);
    track.addEventListener('pointercancel', stop);
  }
</script>
