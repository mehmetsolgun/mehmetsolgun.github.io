---
import { encodeName } from '../lib/dna';

interface Props {
  name: string;
  hint: string;
}
const { name, hint } = Astro.props;
const { codons, protein } = encodeName(name);
const seq = codons.join('');
---

<figure class="helix" data-helix data-seq={seq}>
  <canvas aria-hidden="true"></canvas>
  <figcaption class="wrap mono">
    <span class="strand">5′–<span class="codons">{codons.join(' ')}</span>–3′</span>
    <button type="button" class="translate" data-translate aria-expanded="false">translate()</button>
    <span class="protein" data-protein data-value={protein.join(' ')} aria-live="polite"></span>
    <span class="hint muted">{hint}</span>
  </figcaption>
</figure>

<style>
  .helix {
    margin: 0;
  }
  canvas {
    width: 100%;
    height: clamp(150px, 22vw, 220px);
    touch-action: pan-y;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    margin-top: 6px;
    font-size: 0.75rem;
    color: var(--fg-soft);
  }
  .codons {
    letter-spacing: 0.04em;
  }
  .translate {
    padding: 0;
    border: 0;
    background: none;
    color: var(--accent);
    font: inherit;
    cursor: pointer;
    text-decoration: underline dotted;
    text-underline-offset: 3px;
  }
  .protein {
    color: var(--fg);
    font-weight: 600;
    letter-spacing: 0.12em;
  }
  .protein:not(:empty)::before {
    content: '→ ';
    color: var(--muted);
    font-weight: 400;
  }
  .hint {
    margin-left: auto;
  }
  @media (hover: none) {
    .hint {
      display: none;
    }
  }
</style>

<script>
  type Colors = { fg: string; muted: string; line: string; accent: string };

  const fig = document.querySelector<HTMLElement>('[data-helix]');
  if (fig) {
    const canvas = fig.querySelector('canvas')!;
    const ctx = canvas.getContext('2d')!;
    const seq = fig.dataset.seq || 'ATG';
    const pair: Record<string, string> = { A: 'T', T: 'A', G: 'C', C: 'G' };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const GROOVE = Math.PI * 0.7;

    let w = 0, h = 0, dpr = 1;
    let t = 0;
    let pointerX: number | null = null;
    let open: number[] = [];
    let colors: Colors;
    let visible = true;
    let raf = 0;
    const start = performance.now();

    const readColors = () => {
      const s = getComputedStyle(document.documentElement);
      const v = (n: string) => s.getPropertyValue(n).trim();
      colors = { fg: v('--fg'), muted: v('--muted'), line: v('--line-strong'), accent: v('--accent') };
    };

    const resize = () => {
      dpr = Math.min(devicePixelRatio || 1, 2);
      w = canvas.clientWidth;
      h = canvas.clientHeight;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    };

    const spacing = () => (w < 640 ? 11 : 13);

    const frame = (now: number) => {
      const step = spacing();
      const n = Math.ceil(w / step) + 2;
      if (open.length !== n) open = new Array(n).fill(0);
      const cy = h / 2;
      const amp = h * 0.27;
      const sigma = w < 640 ? 38 : 64;

      // Açılış: polimeraz gibi soldan sağa bir kez geçen kabarcık
      const intro = reduce ? -1 : (now - start) / 2600;
      const bubbleX = pointerX ?? (intro >= 0 && intro <= 1 ? intro * w * 1.2 - w * 0.1 : null);

      const pts: { x: number; top: number; bot: number; zTop: number; zBot: number; o: number; i: number }[] = [];
      for (let i = 0; i < n; i++) {
        const x = i * step;
        const target = bubbleX === null ? 0 : Math.exp(-((x - bubbleX) ** 2) / (2 * sigma ** 2));
        open[i] = reduce ? target : open[i] + (target - open[i]) * 0.1;
        const o = open[i];
        const phase = i * 0.34 + t;
        // İkinci iplik π değil ~0.7π kayık: büyük ve küçük oluklar oluşur
        const phase2 = phase + GROOVE;
        pts.push({
          x,
          top: cy + amp * Math.sin(phase) * (1 - o) - amp * 1.3 * o,
          bot: cy + amp * Math.sin(phase2) * (1 - o) + amp * 1.3 * o,
          zTop: Math.cos(phase),
          zBot: Math.cos(phase2),
          o,
          i,
        });
      }

      ctx.clearRect(0, 0, w, h);

      // Baz çiftleri (hidrojen bağları açıldıkça kaybolur)
      ctx.lineWidth = 1;
      for (const p of pts) {
        const a = (1 - p.o) * 0.55;
        if (a < 0.02) continue;
        ctx.globalAlpha = a;
        ctx.strokeStyle = colors.line;
        ctx.beginPath();
        ctx.moveTo(p.x, p.top);
        ctx.lineTo(p.x, p.bot);
        ctx.stroke();
      }

      // İki iplik; derinliğe göre opaklık
      const strand = (key: 'top' | 'bot') => {
        const zKey = key === 'top' ? 'zTop' : 'zBot';
        for (let k = 1; k < pts.length; k++) {
          const a = pts[k - 1], b = pts[k];
          const depth = (a[zKey] + b[zKey]) / 2;
          const near = Math.max(a.o, b.o);
          ctx.globalAlpha = 0.25 + 0.75 * ((depth + 1) / 2) * (1 - near) + near * 0.9;
          ctx.strokeStyle = near > 0.3 ? colors.accent : depth > 0 ? colors.fg : colors.muted;
          ctx.lineWidth = 1.1 + 0.7 * ((depth + 1) / 2);
          ctx.beginPath();
          ctx.moveTo(a.x, a[key]);
          ctx.lineTo(b.x, b[key]);
          ctx.stroke();
        }
      };
      strand('bot');
      strand('top');

      // Açılan bölgede baz harfleri
      ctx.font = `500 ${w < 640 ? 9 : 10}px 'JetBrains Mono Variable', ui-monospace, monospace`;
      ctx.textAlign = 'center';
      for (const p of pts) {
        if (p.o < 0.18) continue;
        const base = seq[p.i % seq.length];
        ctx.globalAlpha = Math.min(1, (p.o - 0.18) * 1.6);
        ctx.fillStyle = colors.accent;
        ctx.fillText(base, p.x, p.top + 14);
        ctx.fillStyle = colors.muted;
        ctx.fillText(pair[base] || 'N', p.x, p.bot - 7);
      }
      ctx.globalAlpha = 1;

      if (!reduce) {
        t += 0.006;
        if (visible) raf = requestAnimationFrame(frame);
      }
    };

    const redraw = () => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(frame);
    };

    readColors();
    resize();
    new ResizeObserver(() => {
      resize();
      redraw();
    }).observe(canvas);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      if (visible) redraw();
    }).observe(canvas);
    new MutationObserver(() => {
      readColors();
      redraw();
    }).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });

    canvas.addEventListener('pointermove', (e) => {
      pointerX = e.clientX - canvas.getBoundingClientRect().left;
      if (reduce) redraw();
    });
    canvas.addEventListener('pointerleave', () => {
      pointerX = null;
      if (reduce) redraw();
    });

    // translate(): kodonları amino asitlere çevir
    const btn = fig.querySelector<HTMLButtonElement>('[data-translate]')!;
    const out = fig.querySelector<HTMLElement>('[data-protein]')!;
    btn.addEventListener('click', () => {
      const shown = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!shown));
      if (shown) return void (out.textContent = '');
      const letters = (out.dataset.value || '').split(' ');
      if (reduce) return void (out.textContent = letters.join(' '));
      let k = 0;
      out.textContent = '';
      const tick = () => {
        out.textContent = letters.slice(0, ++k).join(' ');
        if (k < letters.length) setTimeout(tick, 90);
      };
      tick();
    });
  }
</script>
