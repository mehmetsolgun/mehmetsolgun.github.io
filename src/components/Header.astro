---
import { getCollection } from 'astro:content';
import Ideogram from './Ideogram.astro';
import profile from '../data/profile.json';
import { href, useTranslations, type Lang } from '../i18n/ui';
import type { ChromName } from '../lib/genome';

interface Props {
  lang: Lang;
  chrom: ChromName;
  pageLabel: string;
  altHref: string;
}
const { lang, chrom, pageLabel, altHref } = Astro.props;
const t = useTranslations(lang);
const path = Astro.url.pathname;
// Yayınlar ilk yayın eklenene kadar Araştırma sayfasının içinde durur
const hasPubs = (await getCollection('publications')).length > 0;

const links = [
  { path: 'about/', label: t('nav.about') },
  { path: 'research/', label: t('nav.research') },
  ...(hasPubs ? [{ path: 'publications/', label: t('nav.publications') }] : []),
  { path: 'notebook/', label: t('nav.notebook') },
  { path: 'blog/', label: t('nav.blog') },
  { path: 'contact/', label: t('nav.contact') },
].map((l) => ({ ...l, url: href(lang, l.path), current: path.startsWith(href(lang, l.path).replace(/\/$/, '')) }));
const other = lang === 'tr' ? 'en' : 'tr';
---

<header class="site-header" data-header>
  <div class="wrap bar">
    <a class="brand" href={href(lang)}>
      <span class="name">{profile.name}</span>
      <span class="mono muted">{profile.credentials}</span>
    </a>
    <nav id="site-nav" class="links" aria-label={t('nav.menu')}>
      {
        links.map((l) => (
          <a href={l.url} aria-current={l.current ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>
    <div class="tools">
      <a class="lang mono" href={altHref} hreflang={other} lang={other} aria-label={t('lang.switch')} title={t('lang.switch')}>
        <span class:list={{ on: lang === 'tr' }}>TR</span>/<span class:list={{ on: lang === 'en' }}>EN</span>
      </a>
      <button class="icon" type="button" data-theme-toggle aria-label={t('theme.toggle')}>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <circle cx="10" cy="10" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
          <path d="M10 3.5a6.5 6.5 0 0 1 0 13z" fill="currentColor"></path>
        </svg>
      </button>
      <button class="icon menu" type="button" data-menu aria-expanded="false" aria-controls="site-nav" aria-label={t('nav.menu')}>
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true">
          <path d="M3 7h14M3 13h14" stroke="currentColor" stroke-width="1.4" fill="none"></path>
        </svg>
      </button>
    </div>
  </div>
  <div class="wrap">
    <Ideogram chrom={chrom} label={pageLabel} />
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    padding-bottom: 6px;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: blur(12px) saturate(1.4);
    -webkit-backdrop-filter: blur(12px) saturate(1.4);
    border-bottom: 1px solid var(--line);
    view-transition-name: site-header;
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 24px;
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: baseline;
    gap: 8px;
    text-decoration: none;
    white-space: nowrap;
  }
  .brand .name {
    font-family: var(--font-serif);
    font-size: 1.1875rem;
    letter-spacing: -0.01em;
  }
  .links {
    display: flex;
    gap: 22px;
    margin-left: auto;
    font-size: 0.9375rem;
  }
  .links a {
    position: relative;
    color: var(--fg-soft);
    text-decoration: none;
    white-space: nowrap;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--fg);
  }
  .links a[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -4px;
    height: 1.5px;
    background: var(--accent);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .lang {
    padding: 6px 8px;
    color: var(--muted);
    text-decoration: none;
    font-size: 0.75rem;
  }
  .lang .on {
    color: var(--fg);
    font-weight: 600;
  }
  .icon {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border: 1px solid transparent;
    border-radius: 999px;
    background: none;
    color: var(--fg-soft);
    cursor: pointer;
  }
  .icon:hover {
    border-color: var(--line-strong);
    color: var(--fg);
  }
  .menu {
    display: none;
  }

  @media (max-width: 860px) {
    .bar {
      gap: 12px;
    }
    .tools {
      margin-left: auto;
    }
    .menu {
      display: grid;
    }
    .links {
      display: none;
      position: absolute;
      top: 100%;
      z-index: 2;
      left: 0;
      right: 0;
      flex-direction: column;
      gap: 0;
      padding: 8px var(--gutter) 16px;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      font-size: 1.0625rem;
    }
    .links a {
      padding: 10px 0;
      border-bottom: 1px solid var(--line);
    }
    .links a[aria-current='page']::after {
      display: none;
    }
    .links a[aria-current='page'] {
      color: var(--accent);
    }
    :global([data-header].open) .links {
      display: flex;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const menu = header.querySelector<HTMLButtonElement>('[data-menu]')!;
  const nav = header.querySelector<HTMLElement>('#site-nav')!;

  const setOpen = (open: boolean, focusMenu = false) => {
    header.classList.toggle('open', open);
    menu.setAttribute('aria-expanded', String(open));
    if (open) nav.querySelector('a')?.focus();
    else if (focusMenu) menu.focus();
  };
  menu.addEventListener('click', () => setOpen(!header.classList.contains('open')));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header.classList.contains('open')) setOpen(false, true);
  });
  document.addEventListener('pointerdown', (e) => {
    if (header.classList.contains('open') && !header.contains(e.target as Node)) setOpen(false);
  });

  header.querySelector('[data-theme-toggle]')!.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>
