---
// Lab defteri kayıtlarını yıllara yayılmış bir genom tarayıcısı "feature track"i olarak çizer.
// Tarih kesinliği görünür: yalnızca yıl bilinen kayıt soluk bir aralık, tam tarihli kayıt ince bir çizgi.
import type { CollectionEntry } from 'astro:content';
import { pick, type Lang } from '../i18n/ui';
import { dateSpan } from '../lib/content';

interface Props {
  entries: CollectionEntry<'notebook'>[];
  lang: Lang;
}
const { entries, lang } = Astro.props;
const spans = entries.map((e) => ({ e, span: dateSpan(e.data.date) }));
const now = new Date().getFullYear();
const r0 = Math.floor(Math.min(now, ...spans.map((s) => s.span[0])));
const r1 = Math.max(now + 1, Math.ceil(Math.max(...spans.map((s) => s.span[1]))));
const pos = (y: number) => ((y - r0) / (r1 - r0)) * 100;
const years = Array.from({ length: r1 - r0 + 1 }, (_, k) => r0 + k);
---

<div class="nt" aria-hidden="true">
  <div class="lane">
    {
      spans.map(({ e, span: [a, b] }) => (
        <span
          class:list={['f', e.data.kind, { range: b > a }]}
          style={`left:${pos(a)}%;width:${b > a ? `${pos(b) - pos(a)}%` : '2px'}`}
          title={`${e.data.date} · ${pick(e.data, 'title', lang)}`}
        />
      ))
    }
  </div>
  <div class="axis mono">
    {years.map((y) => <span style={`left:${pos(y)}%`}>{y}</span>)}
  </div>
</div>

<style>
  .nt {
    margin: 8px 0 28px;
  }
  .lane {
    position: relative;
    height: 26px;
    background: linear-gradient(var(--line-strong), var(--line-strong)) center / 100% 1px no-repeat;
  }
  .f {
    position: absolute;
    top: 4px;
    bottom: 4px;
    border-radius: 1px;
    background: var(--band-3);
  }
  .f.range {
    top: 9px;
    bottom: 9px;
    opacity: 0.35;
  }
  .f.milestone {
    background: var(--accent);
  }
  .axis {
    position: relative;
    height: 18px;
    border-top: 1px solid var(--line);
    font-size: 0.6875rem;
    color: var(--muted);
  }
  .axis span {
    position: absolute;
    top: 4px;
    transform: translateX(-50%);
  }
  .axis span:first-child {
    transform: none;
  }
  .axis span:last-child {
    transform: translateX(-100%);
  }
</style>
