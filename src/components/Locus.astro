---
// Bölüm sarmalayıcı: ideogramda bir işaret oluşturur ve "locus 01 — Başlık" başlığını çizer.
interface Props {
  n: number;
  title: string;
  more?: { href: string; label: string };
  id?: string;
}
const { n, title, more, id } = Astro.props;
---

<section class="section" data-locus={title} id={id}>
  <div class="wrap">
    <header class="locus-head">
      <span class="mono idx">locus {String(n).padStart(2, '0')}</span>
      <h2>{title}</h2>
      {more && <a class="more" href={more.href}>{more.label} →</a>}
    </header>
    <slot />
  </div>
</section>

<style>
  .locus-head {
    display: grid;
    grid-template-columns: 120px 1fr auto;
    align-items: baseline;
    gap: 16px;
    margin-bottom: clamp(24px, 4vw, 40px);
  }
  .idx {
    color: var(--accent);
    font-size: 0.75rem;
  }
  h2 {
    font-size: var(--step-3);
  }
  .more {
    font-size: 0.875rem;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .locus-head {
      grid-template-columns: 1fr auto;
      gap: 6px 12px;
    }
    .idx {
      grid-column: 1 / -1;
    }
  }
</style>
